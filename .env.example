# Local development. Production rejects development-token authentication.
APP_MODE=local
AWS_REGION=ap-southeast-2
STUDENT_ID=n00000000
QUT_USERNAME=student@example.edu
DATA_DIR=.data
DEV_TOKEN=local-development-only
DEV_USER=local-owner
# Optional: allow Bedrock planning locally after choosing an authorised model.
CHAT_MODEL_ID=
# Optional vision and semantic retrieval. Set explicit model IDs after checking account access.
VISION_MODEL_ID=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
VECTOR_BUCKET_NAME=
VECTOR_INDEX_NAME=
# AWS mode: use verified A3 outputs, or explicitly enable Assignment 2 resource reuse below.
REUSE_ASSIGNMENT2_RESOURCES=false
DYNAMODB_LAYOUT=pk-sk
MEDIA_BUCKET=
LIBRARY_TABLE=
PROCESSING_QUEUE_URL=
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=
# Optional private CloudFront delivery, configure with the delivery stack.
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_SECRET_ARN=


